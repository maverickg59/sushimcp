# SushiMCP Registration Configuration
# Copy this file to .env and fill in your values

# Proxy Configuration
API_URL=http://localhost:4111
API_KEY=your-proxy-key-here

# GitHub Configuration
GITHUB_OWNER=your-github-owner
GITHUB_ORG=your-github-org
# Merge method (merge, squash, or rebase)
GITHUB_MERGE_METHOD=merge

# Command line arguments (space-separated)
ARGS="--llms-txt-source hono:https://hono.dev/llms-full.txt"
