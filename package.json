{
  "name": "@chriswhiterocks/sushimcp",
  "version": "0.1.0",
  "description": "SushiMCP a dev tools model context protocol server that serves context on a roll.",
  "type": "module",
  "exports": "./dist/index.js",
  "bin": {
    "sushimcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsup src/index.ts --format esm --tsconfig tsconfig.build.json --watch",
    "dev:inspect": "npm run build && npx -y @modelcontextprotocol/inspector --config inspector-config.json --server sushimcp",
    "build": "tsup src/index.ts --format esm --dts --minify --tsconfig tsconfig.build.json && cp -r static/ dist/static",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "clear:npx:cache": "npx clear-npx-cache",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "snapshot:update": "vitest run -u",
    "generate:key": "node -e \"console.log(crypto.randomUUID())\"",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llms.txt",
    "llms-full.txt",
    "llms-mini.txt",
    "llmstxt",
    "llms-txt",
    "documentation",
    "context",
    "documentation"
  ],
  "author": "Chris White <chris@chriswhite.rocks> (https://chriswhite.rocks)",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maverickg59/sushimcp.git"
  },
  "bugs": {
    "url": "https://github.com/maverickg59/sushimcp/issues"
  },
  "homepage": "https://sushimcp.com",
  "imports": {
    "#lib/*": "./src/lib/*.js",
    "#tools/*": "./src/tools/*.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "commander": "^14.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.0",
    "vitest": "^4.0.18"
  }
}
