{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@modelcontextprotocol/sdk": [
        "./node_modules/@modelcontextprotocol/sdk/dist/esm"
      ],
      "#lib/*": ["./src/lib/*"],
      "#tools/*": ["./src/tools/*"],
      "#resources/*": ["./src/resources/*"]
    }
  },
  "include": ["src/**/*", "__tests__/**/*"],
  "exclude": ["node_modules", "dist"]
}
